# Environment placeholders.
# Copy to `.env.local` for local development.
# Set the same names in the Vercel project environment.
# Do not put secrets in this file.

# Public — safe for the browser client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — used by /api/supabase/connection-test
# Never prefix these with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
